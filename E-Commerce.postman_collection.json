    {
      "name": "Cart",
      "item": [
        {
          "name": "Add New Cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "\r",
                  "// Status Code\r",
                  "pm.test(\"Status code is 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "// Response is JSON\r",
                  "pm.test(\"Response is JSON\", function () {\r",
                  "    pm.response.to.be.json;\r",
                  "});\r",
                  "\r",
                  "// Cart ID exists\r",
                  "pm.test(\"Cart ID is returned\", function () {\r",
                  "    pm.expect(response.id).to.be.a(\"number\");\r",
                  "});\r",
                  "\r",
                  "// User ID is correct\r",
                  "pm.test(\"Correct User ID\", function () {\r",
                  "    pm.expect(response.userId).to.eql(Number(pm.environment.get(\"user_id\")));\r",
                  "});\r",
                  "\r",
                  "// Products array exists\r",
                  "pm.test(\"Products array exists\", function () {\r",
                  "    pm.expect(response.products).to.be.an(\"array\");\r",
                  "});\r",
                  "\r",
                  "// Product added successfully\r",
                  "pm.test(\"One product added\", function () {\r",
                  "    pm.expect(response.products.length).to.be.above(0);\r",
                  "});\r",
                  "\r",
                  "// Correct product added\r",
                  "pm.test(\"Correct Product ID\", function () {\r",
                  "    pm.expect(response.products[0].id).to.eql(Number(pm.environment.get(\"product_id\")));\r",
                  "});\r",
                  "\r",
                  "// Correct quantity\r",
                  "pm.test(\"Quantity is correct\", function () {\r",
                  "    pm.expect(response.products[0].quantity).to.eql(2);\r",
                  "});\r",
