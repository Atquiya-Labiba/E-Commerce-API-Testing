        {
          "name": "Login- Valid Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Parse response\r",
                  "const response = pm.response.json();\r",
                  "\r",
                  "//\r",
                  "// Status Code\r",
                  "//\r",
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// Username matches the credentials used\r",
                  "pm.test(\"Correct username returned\", function () {\r",
                  "    pm.expect(response.username).to.eql(pm.environment.get(\"username\"));\r",
                  "});\r",
                  "\r",
                  "// Response is JSON\r",
                  "pm.test(\"Response is valid JSON\", function () {\r",
                  "    pm.response.to.be.json;\r",
                  "});\r",
                  "\r",
                  "// Access token\r",
                  "pm.test(\"Access token is present\", function () {\r",
                  "    pm.expect(response.accessToken).to.be.a(\"string\").and.not.empty;\r",
                  "});\r",
                  "\r",
                  "// Refresh token\r",
                  "pm.test(\"Refresh token is present\", function () {\r",
                  "    pm.expect(response.refreshToken).to.be.a(\"string\").and.not.empty;\r",
                  "});\r",
                  "\r",
                  "// User ID\r",
                  "pm.test(\"User ID is a positive number\", function () {\r",
                  "    pm.expect(response.id).to.be.a(\"number\").and.above(0);\r",
                  "});\r",
                  "\r",
                  "// Email exists and is a string\r",
                  "pm.test(\"Email is present\", function () {\r",
                  "    pm.expect(response.email).to.be.a(\"string\").and.not.empty;\r",
                  "});\r",
                  "\r",
                  "// Email format\r",
                  "pm.test(\"Email has valid format\", function () {\r",
                  "    const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\r",
                  "\r",
                  "    pm.expect(response.email).to.match(emailRegex);\r",
                  "});\r",
                  "\r",
                  "//\r",
                  "//Data Chaining; Save variables\r",
                  "//\r",
                  "\r",
                  "pm.environment.set(\"token\", response.accessToken);\r",
                  "pm.environment.set(\"refreshToken\", response.refreshToken);\r",
                  "pm.environment.set(\"user_id\", response.id);\r",
                  "pm.environment.set(\"email\", response.email);\r",
                  "\r",
                  "\r",
                  "\r",
                  "//\r",
                  "//Threshold\r",
                  "//\r",
                  "\r",
                  "pm.test(\"Response time is below 1000 ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
